---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../../content/site';

const equipment = await getCollection('equipment');
const ordered = [...equipment].sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.id.localeCompare(b.id)
);
---

<BaseLayout
  title={`Equipment guides | ${site.company.name}`}
  description="General information about lifting equipment and LOLER thorough examinations. These guides are educational and do not confirm that an equipment type is within our inspection scope — contact us to ask about your equipment."
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${site.company.name} home`}>
        <Image
          src={site.assets.logo}
          alt={site.assets.logoAlt}
          width={280}
          height={140}
          class="brand-logo"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a class="text-link" href="/">Back to home <span aria-hidden="true">←</span></a>
    </div>
  </header>

  <main id="main" class="equipment-directory">
    <div class="container equipment-directory-inner">
      <p class="eyebrow"><span></span>Equipment guides</p>
      <h1 id="equipment-directory-title">Equipment guides</h1>
      <p class="equipment-directory-intro">
        General information about lifting equipment and LOLER thorough examinations. These guides are
        educational — they do not confirm that an equipment type is within our inspection scope. Contact
        us to discuss your equipment and confirm whether it is within our inspection scope.
      </p>
      <ul class="equipment-list">
        {ordered.map((entry) => (
          <li class="equipment-list-item">
            <a class="equipment-list-link" href={`/equipment/${entry.id}/`}>
              {entry.data.title}
            </a>
            <p class="equipment-list-description">{entry.data.intro}</p>
          </li>
        ))}
      </ul>
      <a class="button" href="/#contact">
        Make an enquiry<span aria-hidden="true">→</span>
      </a>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="footer-brand" href="#top">{site.company.name}</a>
      <p>{site.company.serviceArea}</p>
    </div>
    <div class="container footer-bottom">
      <span>{site.company.name}. {site.footer.copyright}</span>
      <span>Website created by <em>Connected Web Development</em></span>
    </div>
  </footer>
</BaseLayout>
