---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';

const currentYear = new Date().getFullYear();
const enquiryFormReady = site.contact.form.enabled
  && site.contact.form.providerVerified
  && site.contact.form.privacyApproved
  && site.contact.form.apiKey
  && site.contact.form.successUrl
  && site.company.email
  && site.seo.domainVerified;
---
<BaseLayout>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label={`${site.company.name} home`}>
        <Image src={site.assets.logo} alt={site.assets.logoAlt} width={280} height={140} class="brand-logo" />
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="button button-small header-cta" href="#contact">{site.hero.action}</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="hero-copy-inner">
          <p class="eyebrow"><span></span>{site.hero.eyebrow}</p>
          <h1 id="hero-title">{site.hero.heading}</h1>
          <p class="hero-description">{site.hero.description}</p>
          <div class="hero-actions">
            <a class="button" href="#contact"><span aria-hidden="true">↗</span>{site.hero.action}</a>
            <a class="text-link" href="#services">{site.labels.exploreServices} <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-location">{site.company.base} <span aria-hidden="true">·</span> {site.company.serviceArea}</p>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={site.assets.hero}
          alt={site.hero.imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 860px) 57vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero-image"
        />
        <span class="image-caption">{site.labels.stockCaption}</span>
      </div>
    </section>

    <section class="section services-section" id="services" aria-labelledby="services-title">
      <div class="container service-layout">
        <div class="service-copy">
          <p class="eyebrow"><span></span>{site.labels.services}</p>
          <h2 id="services-title">{site.services.heading}</h2>
          <p>{site.services.description}</p>
          <h3 class="list-heading">{site.services.examplesLabel}</h3>
          <ul class="example-list">
            {site.services.examples.map((example) => <li>{example}</li>)}
          </ul>
          <p class="scope-note">{site.services.examplesNote}</p>
        </div>
        <figure class="service-image-wrap">
          <Image
            src={site.assets.service}
            alt={site.services.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 860px) 38vw, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
            class="service-image"
          />
          <figcaption>{site.labels.stockCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="container about-layout">
        <div class="about-copy">
          <p class="eyebrow"><span></span>{site.labels.about}</p>
          <h2 id="about-title">{site.about.heading}</h2>
          {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="standards-copy" id="standards" aria-labelledby="standards-title">
          <p class="eyebrow"><span></span>{site.labels.standards}</p>
          <h2 id="standards-title">{site.standards.heading}</h2>
          <p>{site.standards.description}</p>
          <a class="text-link regulation-link" href={site.standards.link} target="_blank" rel="noreferrer">
            {site.standards.linkLabel} <span aria-hidden="true">↗</span>
          </a>
          <p class="credential-note">{site.standards.credentialsPending}</p>
        </div>
      </div>
    </section>

    <section class="section contact-section" id="contact" aria-labelledby="contact-title">
      <div class="container contact-layout">
        <div class="contact-copy">
          <p class="eyebrow"><span></span>{site.labels.contact}</p>
          <h2 id="contact-title">{site.contact.heading}</h2>
          <p>{site.contact.description}</p>
          <div class="location-note">
            <span class="location-mark" aria-hidden="true">⌖</span>
            <div>
              <h3>{site.location.heading}</h3>
              <p>{site.location.description}</p>
            </div>
          </div>
        </div>
        <div class="contact-panel">
          <span class="panel-mark" aria-hidden="true">01</span>
          <h3>{site.labels.startConversation}</h3>
          {enquiryFormReady ? (
            <form action={site.contact.form.endpoint} method="POST" class="enquiry-form">
              <input type="hidden" name="apiKey" value={site.contact.form.apiKey} />
              {site.contact.form.successUrl && <input type="hidden" name="redirectTo" value={site.contact.form.successUrl} />}
              <p class="form-required-note">{site.labels.requiredFields}</p>
              <label for="name">Name <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required />
              <label for="company">Company <span class="optional">(optional)</span></label>
              <input id="company" name="company" type="text" autocomplete="organization" />
              <label for="email">Email address <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
              <label for="message">Equipment or service enquiry <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="5" required></textarea>
              <label class="honeypot" aria-hidden="true">Leave this field empty <input name="honeypot" tabindex="-1" autocomplete="off" /></label>
              <button class="button" type="submit">Send enquiry</button>
            </form>
          ) : (
            <>
              <p class="contact-unavailable" id="form-unavailable" role="status">{site.contact.unavailable}</p>
              <form class="enquiry-form" aria-describedby="form-unavailable">
                <fieldset disabled>
                  <legend>Enquiry details</legend>
                  <p class="form-required-note">{site.labels.requiredFields}</p>
                  <label for="name">Name <span aria-hidden="true">*</span></label>
                  <input id="name" name="name" type="text" autocomplete="name" required />
                  <label for="company">Company <span class="optional">(optional)</span></label>
                  <input id="company" name="company" type="text" autocomplete="organization" />
                  <label for="email">Email address <span aria-hidden="true">*</span></label>
                  <input id="email" name="email" type="email" autocomplete="email" required />
                  <label for="message">Equipment or service enquiry <span aria-hidden="true">*</span></label>
                  <textarea id="message" name="message" rows="5" required></textarea>
                  <button class="button" type="button" disabled>Form setup pending</button>
                </fieldset>
              </form>
            </>
          )}
          <p class="email-placeholder">{site.company.emailPlaceholder}</p>
          <a class="text-link" href="/privacy/">Read our privacy notice draft <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="footer-brand" href="#top">{site.company.name}</a>
      <p>{site.company.serviceArea}</p>
      <a href="/privacy/">{site.footer.privacyLabel}</a>
    </div>
    <div class="container footer-bottom">
      <span>© {currentYear} {site.company.name}. {site.footer.copyright}</span>
      <span>{site.company.base}</span>
    </div>
  </footer>
</BaseLayout>
