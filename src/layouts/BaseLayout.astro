---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;
const canonicalUrl = site.seo.domainVerified
  ? new URL(Astro.url.pathname, site.seo.candidateDomain).href
  : undefined;
const socialImage = site.seo.socialImage
  ? new URL(site.seo.socialImage, site.seo.candidateDomain).href
  : undefined;

const basePath = import.meta.env.BASE_URL || '/loler-inspections-site';
const baseUrl = site.seo.candidateDomain + basePath;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.company.name,
  description: site.company.description,
  url: baseUrl,
  logo: `${baseUrl}${site.assets.logo}`,
  image: socialImage ?? `${baseUrl}${site.assets.logo}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.company.base,
    addressCountry: 'GB',
  },
  areaServed: 'United Kingdom',
  priceRange: '££',
  telephone: site.company.emailPlaceholder,
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Lifting Equipment Thorough Examination',
  provider: {
    '@type': 'LocalBusiness',
    name: site.company.name,
  },
  areaServed: 'United Kingdom',
  description: site.services.description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Lifting Equipment Inspections',
    itemListElement: site.services.examples.map((example) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: example },
    })),
  },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10283f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site.seo.domainVerified && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema, null, 2)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema, null, 2)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
