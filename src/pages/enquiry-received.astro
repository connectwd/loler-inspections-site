---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { Image } from 'astro:assets';
---
<BaseLayout title={`Enquiry received | ${site.company.name}`} description="Enquiry form confirmation.">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${site.company.name} home`}>
        <Image src={site.assets.logo} alt={site.assets.logoAlt} width="280" height="140" class="brand-logo" />
      </a>
    </div>
  </header>
  <main id="main" class="privacy-page">
    <div class="container privacy-content">
      <p class="eyebrow"><span></span>Enquiry</p>
      <h1>Thank you</h1>
      <p class="privacy-intro">If you have just submitted an enquiry and were redirected here by our form provider, it has accepted your submission. If you reached this page another way, no enquiry was sent.</p>
      <a class="button" href="/">Return to {site.company.name}</a>
    </div>
  </main>
</BaseLayout>
