---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";

const currentYear = new Date().getFullYear();
const enquiryFormReady =
  site.contact.form.enabled &&
  site.contact.form.providerVerified &&
  site.contact.form.privacyApproved &&
  site.contact.form.apiKey &&
  site.company.email &&
  site.seo.domainVerified;
---

<BaseLayout>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label={`${site.company.name} home`}>
        <Image
          src={site.assets.logo}
          alt={site.assets.logoAlt}
          width={280}
          height={140}
          class="brand-logo"
        />
      </a>
      <a class="button button-small header-cta" href="#contact"
        >{site.hero.action}</a
      >
      <button
        class="menu-toggle"
        id="menu-toggle-button"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
        hidden>Menu</button
      >
      <nav
        class="primary-nav"
        id="primary-navigation"
        aria-label="Primary navigation"
      >
        {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="hero-copy-inner">
          <p class="eyebrow"><span></span>{site.hero.eyebrow}</p>
          <h1 id="hero-title">{site.hero.heading}</h1>
          <p class="hero-description">{site.hero.description}</p>
          <div class="hero-actions">
            <a class="button" href="#contact"
              ><span aria-hidden="true">↗</span>{site.hero.action}</a
            >
            <a class="text-link" href="#services"
              >{site.labels.exploreServices}
              <span aria-hidden="true">→</span></a
            >
          </div>
          <p class="hero-location">
            {site.company.base}
            <span aria-hidden="true">·</span>
            {site.company.serviceArea}
          </p>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={site.assets.hero}
          alt={site.hero.imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 860px) 57vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-image"
        />
      </div>
    </section>

    <section
      class="section services-section"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="container service-layout">
        <div class="service-copy">
          <p class="eyebrow"><span></span>{site.labels.services}</p>
          <h2 id="services-title">{site.services.heading}</h2>
          <p>{site.services.description}</p>
          <h3 class="list-heading">{site.services.examplesLabel}</h3>
          <ul class="example-list">
            {site.services.examples.map((example) => <li>{example}</li>)}
          </ul>
          <!-- <p class="equipment-guides-link">
            <a class="text-link" href="/equipment/">View equipment guides<span aria-hidden="true">→</span></a>
          </p> -->
        </div>
          <Image
            src={site.assets.service}
            alt={site.services.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 860px) 38vw, 100vw"
            loading="lazy"
            class="service-image"
          />
      </div>
    </section>

    <section
      class="section about-section"
      id="about"
      aria-labelledby="about-title"
    >
      <div class="container about-layout">
        <div class="what-is-loler-copy">
          <p class="eyebrow"><span></span>{site.labels.whatIsLOLER}</p>
          <h2 id="about-title">{site.whatIsLOLER.heading}</h2>
          {site.whatIsLOLER.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div
          class="standards-copy"
          id="standards"
          aria-labelledby="standards-title"
        >
          <p class="eyebrow"><span></span>{site.labels.standards}</p>
          <h2 id="standards-title">{site.standards.heading}</h2>
          <p>{site.standards.description}</p>
          <a
            class="text-link regulation-link"
            href={site.standards.link}
            target="_blank"
            rel="noreferrer"
          >
            {site.standards.linkLabel}
            <span aria-hidden="true">↗</span>
          </a>
          <div class="credentials-grid">
            {
              site.standards.credentials.map((credential) => (
                <div class="credential-item">
                  <Image
                    src={credential.logo}
                    alt={credential.name}
                    width={110}
                    height={80}
                  />
                  <span>{credential.name}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="section contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="container contact-layout">
        <div class="container about-contact-wrap">
          <div class="about-copy">
            <p class="eyebrow"><span></span>{site.labels.about}</p>
            <h2 id="about-title">{site.about.heading}</h2>
            {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="contact-copy">
            <p class="eyebrow"><span></span>{site.labels.contact}</p>
            <h2 id="contact-title">{site.contact.heading}</h2>
            <p>{site.contact.description}</p>
          </div>
          <Image
            src={site.assets.contact}
            alt={site.contact.imgAlt}
            width={480}
            class="contact-image"
          />
        </div>
        <div class="contact-panel">
          <h3>{site.labels.startConversation}</h3>
          <form
            action={site.contact.form.endpoint}
            method="POST"
            class="enquiry-form"
          >
            <input type="hidden" name="apiKey" value={staticFormsApiKey} />
            {
              site.contact.form.successUrl && (
                <input
                  type="hidden"
                  name="redirectTo"
                  value={site.contact.form.successUrl}
                />
              )
            }
            <p class="form-required-note">{site.labels.requiredFields}</p>
            <label for="name">
              Name <span aria-hidden="true">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
            <label for="company">
              Company <span aria-hidden="true">*</span>
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              required
            />
            <label for="contactNumber">
              Contact number <span aria-hidden="true">*</span>
            </label>
            <input
              id="contactNumber"
              name="contactNumber"
              type="number"
              autocomplete="tel"
              required
            />
            <label for="email">
              Email address <span aria-hidden="true">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
            <label for="message">
              Equipment or service enquiry <span aria-hidden="true">*</span>
            </label>
            <textarea id="message" name="message" rows="3" required></textarea>
            <label class="honeypot" aria-hidden="true">
              Leave this field empty{" "}
              <input name="honeypot" tabindex="-1" autocomplete="off" />
            </label>
            <button class="button" type="submit"> Send enquiry </button>
          </form>
          <p class="email-placeholder">{site.company.emailPlaceholder}</p>
          <a class="text-link" href="/privacy/"
            >Read our privacy notice<span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="footer-brand" href="#top">{site.company.name}</a>
      <p>{site.company.serviceArea}</p>
      <a href="/privacy/">{site.footer.privacyLabel}</a>
    </div>
    <div class="container footer-bottom">
      <span>© {currentYear} {site.company.name}. {site.footer.copyright}</span>
      <span>Website created by <em>Connected Web Development</em></span>
    </div>
  </footer>
  <script>
    const header = document.querySelector(".site-header");
    const headerCta = document.querySelector<HTMLAnchorElement>(".header-cta");
    const menuToggle =
      document.querySelector<HTMLButtonElement>(".menu-toggle");
    const primaryNavigation = document.querySelector("#primary-navigation");

    if (header && menuToggle && primaryNavigation) {
      const isMobileMenuOpen = () =>
        window.matchMedia("(max-width: 620px)").matches &&
        header.classList.contains("is-menu-open");

      const closeMenu = (restoreFocus = true) => {
        header.classList.remove("is-menu-open");
        menuToggle.setAttribute("aria-expanded", "false");
        if (restoreFocus) menuToggle.focus({ preventScroll: true });
      };

      menuToggle.addEventListener("click", () => {
        const isOpen = header.classList.toggle("is-menu-open");
        menuToggle.setAttribute("aria-expanded", String(isOpen));
      });

      headerCta?.addEventListener("click", () => {
        if (isMobileMenuOpen()) closeMenu(false);
      });

      primaryNavigation.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          if (!isMobileMenuOpen()) return;

          const url = new URL(link.href);
          const isSamePage =
            url.origin === location.origin &&
            url.pathname === location.pathname &&
            url.search === location.search;
          const target =
            isSamePage && link.hash
              ? document.getElementById(decodeURIComponent(link.hash.slice(1)))
              : null;

          if (!target) {
            closeMenu();
            return;
          }

          event.preventDefault();
          closeMenu(false);
          history.pushState(null, "", link.hash);
          target.scrollIntoView();

          const headingId = target
            .getAttribute("aria-labelledby")
            ?.split(/\s+/)[0];
          const destination = headingId
            ? (document.getElementById(headingId) ?? target)
            : target;
          if (!destination.hasAttribute("tabindex"))
            destination.setAttribute("tabindex", "-1");
          destination.focus({ preventScroll: true });
        });
      });

      header.classList.add("is-menu-enhanced");
      menuToggle.hidden = false;
    }
  </script>
</BaseLayout>
