---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { Image } from 'astro:assets';
---
<BaseLayout title={`${site.privacy.pageTitle} | ${site.company.name}`} description="Privacy notice draft awaiting business and provider details.">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${site.company.name} home`}>
        <Image src={site.assets.logo} alt={site.assets.logoAlt} width="280" height="140" class="brand-logo" />
      </a>
      <a class="text-link" href="/">Back to home <span aria-hidden="true">←</span></a>
    </div>
  </header>
  <main id="main" class="privacy-page">
    <div class="container privacy-content">
      <p class="eyebrow"><span></span>Privacy</p>
      <h1>{site.privacy.pageTitle}</h1>
      <p class="draft-warning" role="status">{site.privacy.draftLabel}</p>
      <p class="privacy-intro">This page is a planning draft, not a completed privacy notice or legal advice. Do not collect enquiries through this site until the contact route, provider, data flow, retention, lawful basis, and business privacy contact have been confirmed and this notice approved.</p>
      <div class="privacy-details">
        {site.privacy.details.map((item) => (
          <section aria-labelledby={`privacy-${item.heading.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`}>
            <h2 id={`privacy-${item.heading.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`}>{item.heading}</h2>
            <p>{item.text}</p>
          </section>
        ))}
      </div>
      <a class="button" href="/">Return to LOLER Inspections</a>
    </div>
  </main>
  <footer class="site-footer">
    <div class="container footer-bottom">
      <span>{site.company.name}</span>
      <a href="/">Home</a>
    </div>
  </footer>
</BaseLayout>
